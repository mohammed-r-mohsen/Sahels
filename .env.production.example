# Copy to .env and replace every placeholder. Generate secrets with: openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
REDIS_PASSWORD=REPLACE_WITH_RANDOM_HEX
SAHEL_APP_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_HEX
POSTGRES_EXPORTER_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_HEX
JWT_SECRET=REPLACE_WITH_RANDOM_HEX_AT_LEAST_32_BYTES
INTEGRATION_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_HEX_AT_LEAST_32_BYTES
META_APP_SECRET=REPLACE_WITH_META_APP_SECRET
META_VERIFY_TOKEN=REPLACE_WITH_RANDOM_TOKEN
CORS_ORIGINS=https://app.sahels.net

# Set when enabling the monitoring profile. Use a webhook endpoint compatible with Alertmanager.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_GRAFANA_PASSWORD
ALERTMANAGER_WEBHOOK_URL=https://REPLACE_WITH_ALERTMANAGER_COMPATIBLE_WEBHOOK
ALERT_WEBHOOK_URL=https://REPLACE_WITH_SIMPLE_JSON_WEBHOOK

# Optional billing provider
MOYASAR_SECRET_KEY=sk_test_REPLACE_ME
BILLING_CALLBACK_URL=https://app.sahels.net/api/iam/billing/callback
BILLING_SUCCESS_URL=https://app.sahels.net/dashboard/billing