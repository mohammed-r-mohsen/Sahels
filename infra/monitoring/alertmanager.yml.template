global:
  resolve_timeout: 5m

route:
  receiver: sahels-webhook
  group_by: [alertname, instance]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: sahels-webhook
    webhook_configs:
      - url: "$ALERTMANAGER_WEBHOOK_URL"
        send_resolved: true